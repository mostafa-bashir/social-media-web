# Copy to .env.local. Never commit real values.

# Public URL of this web app
AUTH_URL=http://localhost:3000
# Public origin for SEO metadata, sitemap.xml and robots.txt. Required in production;
# defaults to http://localhost:3000 in development.
SITE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret

# Backend API, used by the Next.js server (auth) and the browser
API_URL=http://localhost:8080/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
